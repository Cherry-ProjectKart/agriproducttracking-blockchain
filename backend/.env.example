# Copy to backend/.env and adjust. Never commit the real .env file.

# Display name returned by GET /api/health
APP_NAME=Blockchain Product Tracking

# SQLite database file. Relative paths resolve from the backend/ folder.
DATABASE_PATH=instance/product_tracking.db

# Comma-separated list of origins allowed to call /api/* (the Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Signs the demo session cookie. Leave empty to generate a random key per run
# (sessions then reset whenever the backend restarts). Use any long random string if set.
SECRET_KEY=

# Send session cookies only over HTTPS. Keep 0 for localhost http://.
SESSION_COOKIE_SECURE=0

# Base URL encoded in batch QR codes. The QR points at {TRACKING_BASE_URL}/track/<batch ID>.
# Localhost works for this computer. To scan with a phone on the same network, use this
# computer's LAN address instead, for example http://192.168.1.20:5173.
TRACKING_BASE_URL=http://localhost:5173

# Flask development server settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
