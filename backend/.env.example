# Copy to backend/.env and adjust. Never commit the real .env file.

# Display name returned by GET /api/health
APP_NAME=Blockchain Product Tracking

# SQLite database file. Relative paths resolve from the backend/ folder.
DATABASE_PATH=instance/product_tracking.db

# Comma-separated list of origins allowed to call /api/* (the Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Signs the session cookie. Leave empty to generate a random key per run
# (sessions then reset whenever the backend restarts). Use any long random string if set.
SECRET_KEY=

# Send session cookies only over HTTPS. Keep 0 for localhost http://.
SESSION_COOKIE_SECURE=0

# How long a sign-in lasts, in hours (0.1 to 168). After this the account must sign in again.
SESSION_LIFETIME_HOURS=12

# Passwords for the three demo accounts (demo.farmer, demo.distributor, demo.retailer).
# Required for the college demonstration. Use passwords of at least 8 characters with a letter and a
# number. They are hashed when the database is initialised and are never shown in the app or the API.
# Leave a value empty to create that demo account without a password (it cannot sign in).
# Set them here, then run: python scripts/init_db.py. Changing a value later does not change a
# password that is already stored; see README "Demo accounts".
DEMO_FARMER_PASSWORD=
DEMO_DISTRIBUTOR_PASSWORD=
DEMO_RETAILER_PASSWORD=

# Base URL encoded in batch QR codes. The QR points at {TRACKING_BASE_URL}/track/<batch ID>.
# Localhost works for this computer. To scan with a phone on the same network, use this
# computer's LAN address instead, for example http://192.168.1.20:5173.
TRACKING_BASE_URL=http://localhost:5173

# Flask development server settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
