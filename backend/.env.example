# Copy to backend/.env and adjust. Never commit the real .env file.

# Display name returned by GET /api/health
APP_NAME=Blockchain Product Tracking

# SQLite database file. Relative paths resolve from the backend/ folder.
DATABASE_PATH=instance/product_tracking.db

# Comma-separated list of origins allowed to call /api/* (the Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Flask development server settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
